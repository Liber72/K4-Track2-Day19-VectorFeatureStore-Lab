# Day 19 lab — env template. Copy to .env and fill in.
# Both paths default to the lite stack; uncomment the docker block to switch.

# ───────────────────────────────────────────────────────────
# Lite path (default) — no services, all in-process
# ───────────────────────────────────────────────────────────
QDRANT_MODE=memory                  # memory | server
QDRANT_URL=http://localhost:6333
# Which embedding model to use. This IS read by app/embeddings.py.
#   fastembed     BAAI/bge-small-en-v1.5          384d   default, ~70 MB, English-focused
#   multilingual  intfloat/multilingual-e5-large 1024d   ~2.2 GB, no extra dependency
#   bge-m3        BAAI/bge-m3                    1024d   ~2.2 GB, needs sentence-transformers
#   openai        text-embedding-3-small         1536d   needs OPENAI_API_KEY, costs money
# Changing this changes the vector dimension. An existing server collection
# must match the model; Searcher checks it before reusing the vectors.
EMBEDDING_BACKEND=fastembed
FEAST_ONLINE_STORE=sqlite           # sqlite | redis
FEAST_OFFLINE_STORE=file            # file | postgres

# ───────────────────────────────────────────────────────────
# Docker path — uncomment when you ran setup-docker.sh
# ───────────────────────────────────────────────────────────
# QDRANT_MODE=server
# QDRANT_URL=http://localhost:6333
# FEAST_ONLINE_STORE=redis
# REDIS_URL=redis://localhost:6379/0
# FEAST_OFFLINE_STORE=postgres
# POSTGRES_URL=postgresql://feast:feast@localhost:5433/feast_offline

# ───────────────────────────────────────────────────────────
# Optional: bonus challenge or §1 swap-in
# ───────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
